# Supabase Configuration
# Get these values from your Supabase project dashboard: Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: for npm run db:fix-user-profiles-rls (direct DB connection)
# From Supabase: Project Settings → Database → Connection string → URI (direct, not pooler)
# POSTGRES_URL_NON_POOLING=postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
